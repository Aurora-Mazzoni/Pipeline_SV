
// percorsi delle variabili 
params.samplesheet = "./samplesheet.csv" //contiene directory dei bam/bai, ordine colonne: sample_id,bam,bai
params.reference = "/mnt/c/Users/aurim/Documents/Università/tirocinio/test_giugno/chm13v2.0.fa" //reference fasta
params.cleaning_script = "./jasmine_cleaning_pos_ins.py" //script per pulire il file di merge di jasmine
params.stats_script = "./sv_stats.py" //script per statistiche dei vcf mergiati da jasmine per campione

// script per le feature di VarTrustML
params.speedxx_script = "./speedxx_fixed.py"
params.merge_script   = "./merge_fixed.py"
params.convert_script = "./convert_sv_fixed.py"

// annotazioni di ripetuti e duplicazioni segmentali per CHM13 
params.repeat_masker  = "./chm13v2.0_RepeatMasker.bed"
params.seg_dups       = "./chm13v2.0_SD.bed"


//Gestione locale o su server
profiles {
    local {
        apptainer.enabled = true
        executor {
            name = "local"
            cpus = 10 
        }
    }
    slurm {
        // DA COMPILARE 
    }
}

// Impostazioni Apptainer
apptainer {
    enabled = true
    autoMounts = true
    // Salva i container scaricati in una cartella per non doverli riscaricare 
    cacheDir = "./apptainer_cache" 
}

// Assegnazione dei container ai processi
process {
    cpus = 1   // valore di default 
    withName: 'RUN_SNIFFLES2|RUN_CUTESV|SV_COVERAGE' { cpus = 4 }
    withName: 'RUN_SNIFFLES2'  { container = "docker://quay.io/biocontainers/sniffles:2.7.5--pyhdfd78af_0" }
    withName: 'RUN_CUTESV'     { container = "docker://quay.io/biocontainers/cutesv:1.0.13--pyhdfd78af_0" }
    withName: 'RUN_SVIM'       { container = "docker://quay.io/biocontainers/svim:2.0.0--pyhdfd78af_0" }

    withName: 'UNION_JASMINE'  { container = "docker://quay.io/biocontainers/jasminesv:1.1.5--hdfd78af_0" }
    withName: 'FILTER_AND_ZIP' { container = "docker://quay.io/biocontainers/bcftools:1.17--h3cc50cf_1" }
    withName: 'CLEAN_JASMINE'  { container = "docker://quay.io/biocontainers/python:3.10" }
    withName: 'SORT_JASMINE'   { container = "docker://quay.io/biocontainers/bcftools:1.17--h3cc50cf_1" }
    withName: 'STAT_VCF'       { container = "docker://quay.io/biocontainers/python:3.10" }
    withName: 'SV_REGIONS_EXTRACT'   { container = "docker://quay.io/biocontainers/bcftools:1.17--h3cc50cf_1" }
    withName: 'SV_COVERAGE'   { container = "docker://quay.io/biocontainers/mosdepth:0.3.6--hd299d5a_0" }
    withName: 'GC_CONTENT'   { container = "docker://quay.io/biocontainers/bedtools:2.31.1--hf5e1c6e_0" }
    withName: 'EXTRACT_FEATURES' { container = "docker://community.wave.seqera.io/library/pyranges_pysam_pandas_procps-ng_scikit-learn:90a52b147254aa1e" ; cpus = 8}

}

// Attiva i report 
report { enabled = true; overwrite = true }
timeline { enabled = true; overwrite = true }
trace    { enabled = true; overwrite = true; fields = 'name,status,realtime,%cpu,peak_rss,peak_vmem' }
